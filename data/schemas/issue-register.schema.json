{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/issue-register.schema.json",
  "title": "Phase0IssueRegister",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "registerID", "createdAt", "updatedAt", "issues"],
  "properties": {
    "schemaVersion": { "const": "phase0-issue-register-v1" },
    "registerID": { "$ref": "#/$defs/id" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "updatedAt": { "$ref": "#/$defs/timestamp" },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "issueKind": {
      "enum": [
        "missingEvidence",
        "wrongOptionAssociation",
        "countMismatch",
        "orderMismatch",
        "inconsistentFraming",
        "inconsistentLighting",
        "wrongCanonicalHair",
        "wrongFacialHair",
        "versionMismatch",
        "platformMismatch",
        "dependencyUncertainty",
        "duplicateAmbiguity",
        "corruptFile",
        "unresolvedPath",
        "recaptureRequired"
      ]
    },
    "severity": { "enum": ["info", "warning", "blocking", "critical"] },
    "status": { "enum": ["open", "inReview", "recaptureQueued", "resolved", "wontFix"] },
    "recaptureQueueStatus": { "enum": ["notQueued", "queued", "captured", "verified", "cancelled"] },
    "capturedAngleID": { "enum": ["straightOn", "left45", "right45", "leftProfile", "rightProfile"] },
    "recaptureRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "queueStatus", "requestedAngles", "requestedEvidenceKinds", "owner", "priority", "notes"],
      "properties": {
        "required": { "type": "boolean" },
        "queueStatus": { "$ref": "#/$defs/recaptureQueueStatus" },
        "requestedAngles": { "type": "array", "items": { "$ref": "#/$defs/capturedAngleID" } },
        "requestedEvidenceKinds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "owner": { "type": "string" },
        "priority": { "$ref": "#/$defs/severity" },
        "notes": { "type": "string" }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issueID",
        "kind",
        "title",
        "description",
        "owner",
        "severity",
        "status",
        "affectedRecordIDs",
        "affectedEvidenceFileIDs",
        "createdAt",
        "updatedAt",
        "resolutionNotes",
        "recaptureRequest"
      ],
      "properties": {
        "issueID": { "$ref": "#/$defs/id" },
        "kind": { "$ref": "#/$defs/issueKind" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "severity": { "$ref": "#/$defs/severity" },
        "status": { "$ref": "#/$defs/status" },
        "affectedRecordIDs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "affectedEvidenceFileIDs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "updatedAt": { "$ref": "#/$defs/timestamp" },
        "resolutionNotes": { "type": "string" },
        "recaptureRequest": { "$ref": "#/$defs/recaptureRequest" }
      }
    }
  }
}
