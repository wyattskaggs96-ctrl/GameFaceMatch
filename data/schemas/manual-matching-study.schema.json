{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/manual-matching-study.schema.json",
  "title": "Phase0ManualMatchingStudyResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceType",
    "studyVersion",
    "studyID",
    "resultID",
    "consentRecord",
    "subjectPseudonymousID",
    "captureMode",
    "referenceViewCompleteness",
    "humanReviewerIDs",
    "rankedHeadChoices",
    "hairChoice",
    "facialHairChoice",
    "subjectPreferredResult",
    "rankSelected",
    "mainMismatchReasons",
    "reviewerAgreement",
    "rawMediaDeletionState",
    "catalogVersion",
    "status",
    "resultTimestamps",
    "notes",
    "isTestFixture"
  ],
  "properties": {
    "schemaVersion": { "const": "phase0-manual-matching-study-v1" },
    "sourceType": { "$ref": "#/$defs/sourceType" },
    "studyVersion": { "$ref": "#/$defs/text" },
    "studyID": { "$ref": "#/$defs/id" },
    "resultID": { "$ref": "#/$defs/id" },
    "consentRecord": { "$ref": "#/$defs/consentRecord" },
    "subjectPseudonymousID": { "$ref": "#/$defs/text" },
    "captureMode": {
      "enum": [
        "webRgbGuided",
        "webManualUpload",
        "iPhoneTrueDepthAssisted",
        "iPhoneTrueDepthSelfScan",
        "standardCamera",
        "screenshotRefinement",
        "unknown"
      ]
    },
    "referenceViewCompleteness": { "$ref": "#/$defs/referenceViewCompleteness" },
    "humanReviewerIDs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/text" } },
    "rankedHeadChoices": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/rankedHeadChoice" }
    },
    "hairChoice": { "anyOf": [{ "$ref": "#/$defs/appearanceChoice" }, { "type": "null" }] },
    "facialHairChoice": { "anyOf": [{ "$ref": "#/$defs/appearanceChoice" }, { "type": "null" }] },
    "subjectPreferredResult": { "anyOf": [{ "$ref": "#/$defs/subjectPreferredResult" }, { "type": "null" }] },
    "rankSelected": { "type": ["integer", "null"], "minimum": 1, "maximum": 3 },
    "mainMismatchReasons": { "type": "array", "items": { "$ref": "#/$defs/mismatchReason" } },
    "reviewerAgreement": { "$ref": "#/$defs/reviewerAgreement" },
    "rawMediaDeletionState": { "$ref": "#/$defs/rawMediaDeletionState" },
    "catalogVersion": { "$ref": "#/$defs/catalogVersion" },
    "originalTopThreeRecommendations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/originalRecommendation" }
    },
    "captureQualitySummary": { "$ref": "#/$defs/captureQualitySummary" },
    "finalInGameSelection": { "anyOf": [{ "$ref": "#/$defs/finalInGameSelection" }, { "type": "null" }] },
    "resemblanceRating": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "repeatScanResult": { "anyOf": [{ "$ref": "#/$defs/repeatScanResult" }, { "type": "null" }] },
    "status": { "enum": ["planned", "inReview", "complete", "withdrawn", "blocked"] },
    "resultTimestamps": { "$ref": "#/$defs/resultTimestamps" },
    "notes": { "$ref": "#/$defs/text" },
    "isTestFixture": { "type": "boolean" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "sourceType": { "enum": ["production", "researchDraft", "testFixture", "demoData", "localDeveloperSample"] },
    "timestamp": { "type": "string", "format": "date-time" },
    "nullableTimestamp": { "type": ["string", "null"], "format": "date-time" },
    "capturedAngle": { "enum": ["straightOn", "left45", "right45", "leftProfile", "rightProfile"] },
    "consentRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consentRecordID",
        "consentVersion",
        "acknowledgedAt",
        "allowsManualReviewerEvaluation",
        "allowsTemporaryRawMediaProcessing",
        "allowsDerivedProfileUse",
        "withdrawalRequestedAt"
      ],
      "properties": {
        "consentRecordID": { "$ref": "#/$defs/id" },
        "consentVersion": { "$ref": "#/$defs/text" },
        "acknowledgedAt": { "$ref": "#/$defs/timestamp" },
        "allowsManualReviewerEvaluation": { "type": "boolean" },
        "allowsTemporaryRawMediaProcessing": { "type": "boolean" },
        "allowsDerivedProfileUse": { "type": "boolean" },
        "withdrawalRequestedAt": { "$ref": "#/$defs/nullableTimestamp" }
      }
    },
    "referenceViewCompleteness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["straightOn", "left45", "right45", "leftProfile", "rightProfile"],
      "properties": {
        "straightOn": { "type": "boolean" },
        "left45": { "type": "boolean" },
        "right45": { "type": "boolean" },
        "leftProfile": { "type": "boolean" },
        "rightProfile": { "type": "boolean" }
      }
    },
    "rankedHeadChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "catalogItemID", "catalogStableInternalID", "reviewerID", "reason"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "catalogItemID": { "$ref": "#/$defs/id" },
        "catalogStableInternalID": { "$ref": "#/$defs/text" },
        "reviewerID": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "appearanceChoice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogItemID", "catalogStableInternalID", "reviewerID", "reason"],
      "properties": {
        "catalogItemID": { "type": ["string", "null"] },
        "catalogStableInternalID": { "type": ["string", "null"] },
        "reviewerID": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "subjectPreferredResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedCatalogItemID", "selectedStableInternalID", "notes"],
      "properties": {
        "selectedCatalogItemID": { "type": ["string", "null"] },
        "selectedStableInternalID": { "type": ["string", "null"] },
        "notes": { "$ref": "#/$defs/text" }
      }
    },
    "mismatchReason": {
      "enum": [
        "headShapeMismatch",
        "jawMismatch",
        "eyeMismatch",
        "noseMismatch",
        "mouthMismatch",
        "hairMismatch",
        "facialHairMismatch",
        "bodyPreferenceMismatch",
        "catalogCoverageGap",
        "captureQuality",
        "lightingOrPose",
        "participantPreference",
        "reviewerDisagreement",
        "uncertain"
      ]
    },
    "originalRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "catalogItemID", "catalogStableInternalID", "matchScore", "confidenceScore", "algorithmVersion", "generatedAt"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1, "maximum": 3 },
        "catalogItemID": { "$ref": "#/$defs/id" },
        "catalogStableInternalID": { "$ref": "#/$defs/text" },
        "matchScore": { "type": ["number", "null"], "minimum": 0 },
        "confidenceScore": { "type": ["number", "null"], "minimum": 0 },
        "algorithmVersion": { "$ref": "#/$defs/text" },
        "generatedAt": { "$ref": "#/$defs/timestamp" }
      }
    },
    "captureQualitySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualityState", "overallScore", "blockingIssueCount", "advisoryIssueCount", "notes"],
      "properties": {
        "qualityState": { "enum": ["passed", "passedWithWarnings", "failed", "notRecorded"] },
        "overallScore": { "type": ["number", "null"], "minimum": 0 },
        "blockingIssueCount": { "type": "integer", "minimum": 0 },
        "advisoryIssueCount": { "type": "integer", "minimum": 0 },
        "notes": { "$ref": "#/$defs/text" }
      }
    },
    "finalInGameSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selectedCatalogItemID", "selectedStableInternalID", "builtInGame", "notes"],
      "properties": {
        "selectedCatalogItemID": { "type": ["string", "null"] },
        "selectedStableInternalID": { "type": ["string", "null"] },
        "builtInGame": { "type": "boolean" },
        "notes": { "$ref": "#/$defs/text" }
      }
    },
    "repeatScanResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completed", "repeatScanID", "captureMode", "completedAt", "topThreeStableInternalIDs", "sameTopChoice", "topThreeOverlapCount", "notes"],
      "properties": {
        "completed": { "type": "boolean" },
        "repeatScanID": { "type": ["string", "null"] },
        "captureMode": {
          "enum": [
            "webRgbGuided",
            "webManualUpload",
            "iPhoneTrueDepthAssisted",
            "iPhoneTrueDepthSelfScan",
            "standardCamera",
            "screenshotRefinement",
            "unknown",
            null
          ]
        },
        "completedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "topThreeStableInternalIDs": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "sameTopChoice": { "type": ["boolean", "null"] },
        "topThreeOverlapCount": { "type": ["integer", "null"], "minimum": 0, "maximum": 3 },
        "notes": { "$ref": "#/$defs/text" }
      }
    },
    "reviewerAgreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewerIDs", "agreedTopChoice", "agreedTopThreeSet", "agreementNotes"],
      "properties": {
        "reviewerIDs": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/text" } },
        "agreedTopChoice": { "type": ["boolean", "null"] },
        "agreedTopThreeSet": { "type": ["boolean", "null"] },
        "agreementNotes": { "$ref": "#/$defs/text" }
      }
    },
    "rawMediaDeletionState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "requestedAt", "completedAt", "verifiedBy", "retentionConsentRecordID"],
      "properties": {
        "status": { "enum": ["notCaptured", "pendingDeletion", "deleted", "retainedWithExplicitConsent"] },
        "requestedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "completedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "verifiedBy": { "type": ["string", "null"] },
        "retentionConsentRecordID": { "type": ["string", "null"] }
      }
    },
    "catalogVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogVersionID", "game", "platform", "gameVersion", "patchVersion", "verifiedAt"],
      "properties": {
        "catalogVersionID": { "$ref": "#/$defs/text" },
        "game": { "$ref": "#/$defs/text" },
        "platform": { "$ref": "#/$defs/text" },
        "gameVersion": { "$ref": "#/$defs/text" },
        "patchVersion": { "$ref": "#/$defs/text" },
        "verifiedAt": { "$ref": "#/$defs/nullableTimestamp" }
      }
    },
    "resultTimestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capturedAt", "reviewedAt", "subjectSelectedAt", "finalizedAt"],
      "properties": {
        "capturedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "reviewedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "subjectSelectedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "finalizedAt": { "$ref": "#/$defs/nullableTimestamp" }
      }
    }
  }
}
