{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/cf27-production-verification-queue.schema.json",
  "title": "College Football 27 Production Verification Queue",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "productionStatus",
    "verificationStatus",
    "verificationHasOccurred",
    "productionRecommendationsEnabled",
    "allowedSecondVerifierStatuses",
    "summary",
    "categoryCounts",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "cf27-production-verification-queue-v1"
    },
    "productionStatus": {
      "const": "NOT_PRODUCTION_DATA"
    },
    "verificationStatus": {
      "const": "NOT_VERIFIED"
    },
    "verificationHasOccurred": {
      "const": false
    },
    "productionRecommendationsEnabled": {
      "const": false
    },
    "allowedSecondVerifierStatuses": {
      "type": "array",
      "items": {
        "enum": [
          "VERIFIED",
          "VERIFIED_WITH_NOTES",
          "RECAPTURE_REQUIRED",
          "VERSION_MISMATCH",
          "MISSING_EVIDENCE",
          "COUNT_MISMATCH",
          "ORDER_MISMATCH",
          "DEPENDENCY_UNRESOLVED",
          "NOT_VERIFIED"
        ]
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "totalCandidates",
        "evidenceLinkedCount",
        "missingEvidenceCount",
        "secondVerifiedRecords",
        "productionApprovedRecords",
        "productionCatalogRecords",
        "productionEligibleCount"
      ]
    },
    "categoryCounts": {
      "type": "array"
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "queueRecordID",
          "stableCandidateID",
          "category",
          "primaryReviewStatus",
          "evidenceReferences",
          "sourceVideoReferences",
          "requiredViews",
          "availableViews",
          "missingViews",
          "recommendedVerifierAction",
          "recommendedRecaptureAction",
          "currentProductionEligibility",
          "blockingReasons",
          "secondVerifierStatus",
          "catalogManagerDisposition"
        ],
        "properties": {
          "currentProductionEligibility": {
            "const": "NOT_ELIGIBLE"
          },
          "secondVerifierStatus": {
            "const": "NOT_VERIFIED"
          },
          "evidenceReferences": {
            "type": "array",
            "minItems": 1
          },
          "sourceVideoReferences": {
            "type": "array",
            "minItems": 1
          },
          "blockingReasons": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  }
}
