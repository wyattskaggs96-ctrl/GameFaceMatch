{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/review-record.schema.json",
  "title": "ReviewRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["reviewID", "stableInternalID", "reviewer", "reviewedAt", "decision", "checks"],
  "properties": {
    "reviewID": { "type": "string", "minLength": 1 },
    "stableInternalID": { "type": "string", "minLength": 1 },
    "reviewer": { "type": "string", "minLength": 1 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "decision": { "enum": ["approved", "rejected"] },
    "checks": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "notes": { "type": "string" }
  }
}
