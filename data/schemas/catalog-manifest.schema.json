{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/catalog-manifest.schema.json",
  "title": "GameCatalogManifest",
  "type": "object",
  "additionalProperties": true,
  "required": ["sourceType", "catalogVersion", "generatedAt", "isProduction", "items"],
  "properties": {
    "sourceType": { "$ref": "#/$defs/sourceType" },
    "catalogVersion": {
      "type": "object",
      "required": ["identifier", "gameVersion", "platform", "verifiedAt"],
      "properties": {
        "identifier": { "type": "string" },
        "gameVersion": { "type": "string" },
        "platform": { "type": "string" },
        "verifiedAt": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "isProduction": { "type": "boolean" },
    "declaredItemCount": { "type": "integer", "minimum": 0 },
    "packageChecksum": { "type": "string" },
    "releaseStatus": { "enum": ["draft", "reviewCandidate", "verificationCandidate", "approvedRelease", "supersededRelease", "rejectedRelease"] },
    "previousCatalogVersionID": { "type": ["string", "null"] },
    "supersededByCatalogVersionID": { "type": ["string", "null"] },
    "releaseNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "createdAt", "author", "changes"],
      "properties": {
        "summary": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "author": { "type": "string" },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "description"],
            "properties": {
              "type": { "enum": ["added", "corrected", "removed", "superseded", "metadataOnly"] },
              "stableInternalID": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "items": { "type": "array", "items": { "$ref": "catalog-item.schema.json" } }
  },
  "$defs": {
    "sourceType": {
      "enum": ["production", "researchDraft", "testFixture", "demoData", "localDeveloperSample"]
    }
  }
}
