{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/facial-measurement.schema.json",
  "title": "FacialMeasurement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "value",
    "confidence",
    "supportingFrameCount",
    "variance",
    "depthSupported",
    "occlusionStatus",
    "measurementSource",
    "availabilityState"
  ],
  "properties": {
    "value": { "type": "number" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "supportingFrameCount": { "type": "integer", "minimum": 0 },
    "variance": { "type": "number", "minimum": 0 },
    "depthSupported": { "type": "boolean" },
    "occlusionStatus": { "enum": ["none", "partial", "significant", "unknown"] },
    "measurementSource": { "type": "string", "minLength": 1 },
    "availabilityState": { "enum": ["available", "pending", "unavailable"] }
  }
}
