{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/head-capture-workspace.schema.json",
  "title": "Phase0HeadCaptureWorkspace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspaceID",
    "createdAt",
    "updatedAt",
    "gameID",
    "platformCode",
    "modeCode",
    "gameVersionID",
    "patchID",
    "creationPathID",
    "menuMapID",
    "canonicalCaptureConfigurationHash",
    "doubleCountRuns",
    "entries"
  ],
  "properties": {
    "schemaVersion": { "const": "phase0-head-capture-workspace-v1" },
    "workspaceID": { "$ref": "#/$defs/id" },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "updatedAt": { "$ref": "#/$defs/timestamp" },
    "gameID": { "$ref": "#/$defs/id" },
    "platformCode": { "$ref": "#/$defs/code" },
    "modeCode": { "$ref": "#/$defs/code" },
    "gameVersionID": { "$ref": "#/$defs/id" },
    "patchID": { "$ref": "#/$defs/id" },
    "creationPathID": { "$ref": "#/$defs/id" },
    "menuMapID": { "$ref": "#/$defs/id" },
    "canonicalCaptureConfigurationHash": { "type": ["string", "null"] },
    "doubleCountRuns": { "type": "array", "items": { "$ref": "#/$defs/doubleCountRun" } },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/headEntry" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "pattern": "^[A-Z0-9]+$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "viewID": { "enum": ["front", "leftThreeQuarter", "leftProfile", "rightThreeQuarter", "rightProfile", "elevated", "lowered", "fullScreenMenu"] },
    "verificationState": { "enum": ["draft", "firstReviewPending", "firstReviewApproved", "secondReviewPending", "verified", "rejected", "retired"] },
    "doubleCountRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runID", "runNumber", "observedCount", "startedAt", "completedAt", "sourceVideoEvidenceID", "notes"],
      "properties": {
        "runID": { "$ref": "#/$defs/id" },
        "runNumber": { "type": "integer", "minimum": 1 },
        "observedCount": { "type": ["integer", "null"], "minimum": 0 },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "sourceVideoEvidenceID": { "type": ["string", "null"] },
        "notes": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceFileID", "viewID", "sourceVideoID", "sourceVideoTimestamp", "notes"],
      "properties": {
        "evidenceFileID": { "$ref": "#/$defs/id" },
        "viewID": { "$ref": "#/$defs/viewID" },
        "sourceVideoID": { "type": ["string", "null"] },
        "sourceVideoTimestamp": { "type": ["string", "null"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "duplicateObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationID", "kind", "comparedStableID", "evidenceFileIDs", "notes"],
      "properties": {
        "observationID": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["duplicate", "nearDuplicate"] },
        "comparedStableID": { "$ref": "#/$defs/id" },
        "evidenceFileIDs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "headEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entryID",
        "stableInternalID",
        "nativeOrder",
        "visibleGameLabelOrIndex",
        "selectorWrapBehavior",
        "lockStatus",
        "entitlementDependency",
        "forcedAttributes",
        "canonicalSettingsConfirmed",
        "canonicalSettingsHash",
        "fullScreenMenuEvidenceIDs",
        "viewEvidence",
        "duplicateObservations",
        "captureCompletionStatus",
        "verificationStatus",
        "catalogManagerDisposition",
        "notes"
      ],
      "properties": {
        "entryID": { "$ref": "#/$defs/id" },
        "stableInternalID": { "type": "string", "pattern": "^CF27_[A-Z0-9]+_[A-Z0-9]+_HEAD_[0-9]{3}$" },
        "nativeOrder": { "type": "integer", "minimum": 1 },
        "visibleGameLabelOrIndex": { "type": "string", "minLength": 1 },
        "selectorWrapBehavior": { "enum": ["wraps", "clamps", "unknown"] },
        "lockStatus": { "enum": ["unlocked", "locked", "entitlementDependent", "unknown"] },
        "entitlementDependency": { "type": ["string", "null"] },
        "forcedAttributes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "canonicalSettingsConfirmed": { "type": "boolean" },
        "canonicalSettingsHash": { "type": ["string", "null"] },
        "fullScreenMenuEvidenceIDs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "viewEvidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "duplicateObservations": { "type": "array", "items": { "$ref": "#/$defs/duplicateObservation" } },
        "captureCompletionStatus": { "enum": ["notStarted", "inProgress", "complete", "blocked"] },
        "verificationStatus": { "$ref": "#/$defs/verificationState" },
        "catalogManagerDisposition": { "enum": ["notReady", "readyForReview", "accepted", "rejected", "deferred"] },
        "notes": { "type": "string" }
      }
    }
  }
}
