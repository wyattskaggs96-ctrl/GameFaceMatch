{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/facial-hair-option.schema.json",
  "title": "Phase0FacialHairRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stableInternalID",
    "kind",
    "gameID",
    "platformCode",
    "modeCode",
    "gameVersionID",
    "patchID",
    "creationPathID",
    "menuMapID",
    "menuItemID",
    "nativeCategoryLabel",
    "visibleGameLabelOrIndex",
    "nativeOrder",
    "evidence",
    "dependencies",
    "canonicalSettings",
    "verificationState",
    "firstReviewID",
    "secondReviewID",
    "deprecationState",
    "deprecatedReason",
    "supersedesStableID",
    "supersededByStableID",
    "lastCheckedDate",
    "isTestFixture",
    "notes",
    "standardizedCoverage",
    "obscuresJawline",
    "obscuresMouth"
  ],
  "properties": {
    "schemaVersion": { "const": "phase0-catalog-item-v1" },
    "stableInternalID": { "type": "string", "pattern": "^CF27_[A-Z0-9]+_[A-Z0-9]+_FACIALHAIR_[0-9]{3}$" },
    "kind": { "const": "facialHair" },
    "gameID": { "$ref": "#/$defs/id" },
    "platformCode": { "$ref": "#/$defs/code" },
    "modeCode": { "$ref": "#/$defs/code" },
    "gameVersionID": { "$ref": "#/$defs/id" },
    "patchID": { "$ref": "#/$defs/id" },
    "creationPathID": { "$ref": "#/$defs/id" },
    "menuMapID": { "$ref": "#/$defs/id" },
    "menuItemID": { "$ref": "#/$defs/id" },
    "nativeCategoryLabel": { "$ref": "#/$defs/text" },
    "visibleGameLabelOrIndex": { "$ref": "#/$defs/text" },
    "nativeOrder": { "type": "integer", "minimum": 1 },
    "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceReference" } },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "canonicalSettings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/canonicalSetting" } },
    "verificationState": { "$ref": "#/$defs/verificationState" },
    "firstReviewID": { "type": ["string", "null"] },
    "secondReviewID": { "type": ["string", "null"] },
    "deprecationState": { "$ref": "#/$defs/deprecationState" },
    "deprecatedReason": { "type": ["string", "null"] },
    "supersedesStableID": { "type": ["string", "null"] },
    "supersededByStableID": { "type": ["string", "null"] },
    "lastCheckedDate": { "$ref": "#/$defs/date" },
    "isTestFixture": { "type": "boolean" },
    "notes": { "$ref": "#/$defs/text" },
    "standardizedCoverage": { "enum": ["unknown", "none", "mustache", "goatee", "beard", "mixed"] },
    "obscuresJawline": { "type": ["boolean", "null"] },
    "obscuresMouth": { "type": ["boolean", "null"] }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "pattern": "^[A-Z0-9]+$" },
    "text": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "verificationState": { "enum": ["draft", "firstReviewPending", "firstReviewApproved", "secondReviewPending", "verified", "rejected", "retired"] },
    "deprecationState": { "enum": ["active", "deprecated", "superseded", "retired"] },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceFileID", "purpose", "requiredAngleID", "notes"],
      "properties": {
        "evidenceFileID": { "$ref": "#/$defs/id" },
        "purpose": { "enum": ["optionIdentity", "menuNavigation", "requiredAngle", "dependency", "review", "deprecation", "supersession"] },
        "requiredAngleID": { "type": ["string", "null"] },
        "notes": { "$ref": "#/$defs/text" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencyID", "dependsOnStableID", "dependsOnMenuID", "condition", "evidenceFileIDs"],
      "properties": {
        "dependencyID": { "$ref": "#/$defs/id" },
        "dependsOnStableID": { "type": ["string", "null"] },
        "dependsOnMenuID": { "type": ["string", "null"] },
        "condition": { "$ref": "#/$defs/text" },
        "evidenceFileIDs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "canonicalSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settingID", "menuMapID", "menuItemID", "nativeLabel", "visibleLabelOrIndex", "nativeOrder", "valueType", "canonicalValue", "navigationInstructionIDs", "evidenceFileIDs", "notes"],
      "properties": {
        "settingID": { "$ref": "#/$defs/id" },
        "menuMapID": { "$ref": "#/$defs/id" },
        "menuItemID": { "$ref": "#/$defs/id" },
        "nativeLabel": { "$ref": "#/$defs/text" },
        "visibleLabelOrIndex": { "$ref": "#/$defs/text" },
        "nativeOrder": { "type": "integer", "minimum": 1 },
        "valueType": { "enum": ["label", "index", "number", "boolean", "color", "unknown"] },
        "canonicalValue": { "type": ["string", "number", "boolean", "null"] },
        "navigationInstructionIDs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "evidenceFileIDs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "notes": { "$ref": "#/$defs/text" }
      }
    }
  }
}
