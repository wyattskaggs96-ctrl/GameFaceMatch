{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/menu-map.schema.json",
  "title": "Phase0MenuMap",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mapID", "createdAt", "updatedAt", "gameID", "creationPathID", "catalogVersionID", "items"],
  "properties": {
    "schemaVersion": { "const": "phase0-menu-map-v1" },
    "mapID": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "gameID": { "type": "string", "minLength": 1 },
    "creationPathID": { "type": "string", "minLength": 1 },
    "catalogVersionID": { "type": ["string", "null"] },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/menuItem" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "evidenceIDs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceFileID", "description"],
      "properties": {
        "evidenceFileID": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "scrollingContinuationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromMenuID", "toMenuID", "direction", "evidenceFileIDs", "notes"],
      "properties": {
        "fromMenuID": { "$ref": "#/$defs/id" },
        "toMenuID": { "$ref": "#/$defs/id" },
        "direction": { "enum": ["up", "down", "left", "right"] },
        "evidenceFileIDs": { "$ref": "#/$defs/evidenceIDs" },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "dependsOnMenuID", "condition", "evidenceFileIDs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "dependsOnMenuID": { "$ref": "#/$defs/id" },
        "condition": { "type": "string", "minLength": 1 },
        "evidenceFileIDs": { "$ref": "#/$defs/evidenceIDs" }
      }
    },
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason", "evidenceFileIDs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1 },
        "evidenceFileIDs": { "$ref": "#/$defs/evidenceIDs" }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "message", "evidenceFileIDs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "message": { "type": "string", "minLength": 1 },
        "evidenceFileIDs": { "$ref": "#/$defs/evidenceIDs" }
      }
    },
    "defect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "severity", "evidenceFileIDs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["minor", "major", "blocking"] },
        "evidenceFileIDs": { "$ref": "#/$defs/evidenceIDs" }
      }
    },
    "menuItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stableMenuID",
        "parentMenuID",
        "displayLabel",
        "nativeLabel",
        "nativeOrder",
        "controlType",
        "minimum",
        "maximum",
        "step",
        "defaultValue",
        "totalValues",
        "wrapBehavior",
        "visibleLabelState",
        "advancedControl",
        "resetBehavior",
        "laterEditability",
        "dependencies",
        "locks",
        "warnings",
        "defects",
        "environmentID",
        "evidence",
        "scrollingContinuationEvidence",
        "captureResearcher",
        "verifier",
        "verificationStatus",
        "notes"
      ],
      "properties": {
        "stableMenuID": { "$ref": "#/$defs/id" },
        "parentMenuID": { "type": ["string", "null"] },
        "displayLabel": { "type": "string", "minLength": 1 },
        "nativeLabel": { "type": "string", "minLength": 1 },
        "nativeOrder": { "type": "integer", "minimum": 1 },
        "controlType": { "enum": ["menu", "submenu", "list", "carousel", "slider", "toggle", "text", "colorPicker", "numericStepper", "unknown"] },
        "minimum": { "type": ["number", "null"] },
        "maximum": { "type": ["number", "null"] },
        "step": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "defaultValue": { "type": ["string", "number", "boolean", "null"] },
        "totalValues": { "type": ["integer", "null"], "minimum": 1 },
        "wrapBehavior": { "enum": ["wraps", "clamps", "none", "unknown"] },
        "visibleLabelState": { "enum": ["visible", "hidden", "conditional", "unknown"] },
        "advancedControl": { "type": "boolean" },
        "resetBehavior": { "enum": ["resetsToDefault", "persists", "resetsToPrevious", "unknown"] },
        "laterEditability": { "enum": ["editableLater", "lockedAfterCreation", "conditional", "unknown"] },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
        "locks": { "type": "array", "items": { "$ref": "#/$defs/lock" } },
        "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } },
        "defects": { "type": "array", "items": { "$ref": "#/$defs/defect" } },
        "environmentID": { "$ref": "#/$defs/id" },
        "evidence": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceReference" } },
        "scrollingContinuationEvidence": { "type": "array", "items": { "$ref": "#/$defs/scrollingContinuationEvidence" } },
        "captureResearcher": { "type": "string", "minLength": 1 },
        "verifier": { "type": ["string", "null"] },
        "verificationStatus": { "enum": ["draft", "firstReviewPending", "firstReviewApproved", "secondReviewPending", "verified", "rejected", "retired"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
