{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/capture-log.schema.json",
  "title": "Phase0CaptureLog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "captureLogID",
    "auditSessionID",
    "environmentID",
    "platformID",
    "gameVersionID",
    "patchID",
    "mode",
    "creationPathID",
    "catalogItemID",
    "startedAt",
    "completedAt",
    "primaryOperatorID",
    "actions",
    "settingSnapshots",
    "generatedEvidenceIDs",
    "issueIDs",
    "retakeCount",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": "phase0-capture-log-v1" },
    "captureLogID": { "$ref": "#/$defs/id" },
    "auditSessionID": { "$ref": "#/$defs/id" },
    "environmentID": { "$ref": "#/$defs/id" },
    "platformID": { "$ref": "#/$defs/id" },
    "gameVersionID": { "$ref": "#/$defs/id" },
    "patchID": { "$ref": "#/$defs/id" },
    "mode": { "$ref": "#/$defs/text" },
    "creationPathID": { "$ref": "#/$defs/id" },
    "catalogItemID": { "type": ["string", "null"] },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "primaryOperatorID": { "$ref": "#/$defs/text" },
    "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/action" } },
    "settingSnapshots": { "type": "array", "items": { "$ref": "#/$defs/settingSnapshot" } },
    "generatedEvidenceIDs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "issueIDs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
    "retakeCount": { "type": "integer", "minimum": 0 },
    "notes": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionID",
        "actionAt",
        "actionKind",
        "operatorID",
        "settingSnapshotIDs",
        "generatedEvidenceIDs",
        "issueIDs",
        "retakeOfEvidenceID",
        "notes"
      ],
      "properties": {
        "actionID": { "$ref": "#/$defs/id" },
        "actionAt": { "type": "string", "format": "date-time" },
        "actionKind": {
          "enum": [
            "sessionStarted",
            "settingSnapshot",
            "evidenceCaptured",
            "issueLogged",
            "retakeRequested",
            "retakeCompleted",
            "verificationAction",
            "sessionCompleted",
            "sessionCancelled",
            "note"
          ]
        },
        "operatorID": { "$ref": "#/$defs/text" },
        "settingSnapshotIDs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "generatedEvidenceIDs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "issueIDs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "retakeOfEvidenceID": { "type": ["string", "null"] },
        "notes": { "$ref": "#/$defs/text" }
      }
    },
    "settingSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotID",
        "menuMapID",
        "menuItemID",
        "visibleLabelOrIndex",
        "nativeOrder",
        "canonicalValue",
        "evidenceFileIDs",
        "notes"
      ],
      "properties": {
        "snapshotID": { "$ref": "#/$defs/id" },
        "menuMapID": { "$ref": "#/$defs/id" },
        "menuItemID": { "$ref": "#/$defs/id" },
        "visibleLabelOrIndex": { "$ref": "#/$defs/text" },
        "nativeOrder": { "type": ["integer", "null"], "minimum": 1 },
        "canonicalValue": { "type": ["string", "number", "boolean", "null"] },
        "evidenceFileIDs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "notes": { "$ref": "#/$defs/text" }
      }
    }
  }
}
