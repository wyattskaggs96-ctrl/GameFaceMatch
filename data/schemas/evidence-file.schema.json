{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/evidence-file.schema.json",
  "title": "Phase0EvidenceFileRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stableEvidenceID",
    "relativePath",
    "derivativeState",
    "fileRole",
    "sha256",
    "sizeBytes",
    "mimeType",
    "platformID",
    "gameVersionID",
    "patchID",
    "mode",
    "creationPathID",
    "environmentID",
    "catalogItemID",
    "view",
    "captureMethod",
    "captureDevice",
    "capturedAt",
    "researcherID",
    "verifierID",
    "verificationStatus",
    "supersededEvidenceID",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": "phase0-evidence-v1" },
    "stableEvidenceID": { "type": "string", "minLength": 1 },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?![a-zA-Z][a-zA-Z0-9+.-]*://)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
      "description": "Production evidence must use repository-relative paths, not absolute local paths, URLs, or parent-directory traversal."
    },
    "derivativeState": { "enum": ["master", "derivative"] },
    "fileRole": { "enum": ["standardAngle", "navigationEvidence", "menuState", "environment", "review", "checksumManifest", "notes", "other"] },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sizeBytes": { "type": "integer", "minimum": 1 },
    "mimeType": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.+-]*/[a-z0-9][a-z0-9.+-]*$" },
    "platformID": { "$ref": "#/$defs/id" },
    "gameVersionID": { "$ref": "#/$defs/id" },
    "patchID": { "$ref": "#/$defs/id" },
    "mode": { "$ref": "#/$defs/text" },
    "creationPathID": { "$ref": "#/$defs/id" },
    "environmentID": { "$ref": "#/$defs/id" },
    "catalogItemID": { "type": ["string", "null"] },
    "view": { "enum": ["straightOn", "left45", "right45", "leftProfile", "rightProfile", "navigationEvidence", "menuOverview", "environment", "notApplicable"] },
    "captureMethod": { "enum": ["consoleScreenshot", "captureCard", "phonePhoto", "screenRecording", "manualEntry", "export", "unknown"] },
    "captureDevice": { "$ref": "#/$defs/text" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "researcherID": { "$ref": "#/$defs/text" },
    "verifierID": { "type": ["string", "null"] },
    "verificationStatus": { "$ref": "#/$defs/verificationState" },
    "supersededEvidenceID": { "type": ["string", "null"] },
    "notes": { "$ref": "#/$defs/text" }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1 },
    "text": { "type": "string", "minLength": 1 },
    "verificationState": { "enum": ["draft", "firstReviewPending", "firstReviewApproved", "secondReviewPending", "verified", "rejected", "retired"] }
  }
}
