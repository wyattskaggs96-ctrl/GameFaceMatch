{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/required-view-completeness.schema.json",
  "title": "Phase0RequiredViewCompletenessReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "category",
    "entityID",
    "label",
    "rows",
    "summary",
    "productionCompletionAllowed",
    "productionBlockers",
    "notice"
  ],
  "properties": {
    "schemaVersion": { "const": "phase0-required-view-completeness-v1" },
    "category": {
      "enum": ["heads", "hairstyles", "facialHair", "additionalAttributes", "environmentEvidence", "menuEvidence"]
    },
    "entityID": { "$ref": "#/$defs/requiredText" },
    "label": { "$ref": "#/$defs/requiredText" },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requiredViewState" }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiredCount",
        "presentCount",
        "missingCount",
        "rejectedCount",
        "recaptureRequestedCount",
        "verifiedCount",
        "blockingCount"
      ],
      "properties": {
        "requiredCount": { "type": "integer", "minimum": 0 },
        "presentCount": { "type": "integer", "minimum": 0 },
        "missingCount": { "type": "integer", "minimum": 0 },
        "rejectedCount": { "type": "integer", "minimum": 0 },
        "recaptureRequestedCount": { "type": "integer", "minimum": 0 },
        "verifiedCount": { "type": "integer", "minimum": 0 },
        "blockingCount": { "type": "integer", "minimum": 0 }
      }
    },
    "productionCompletionAllowed": { "type": "boolean" },
    "productionBlockers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "notice": {
      "type": "string",
      "pattern": "blocks production.*does not auto-verify|does not auto-verify.*blocks production"
    }
  },
  "$defs": {
    "requiredText": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "REPLACE_WITH_|NOT PRODUCTION DATA|NOT A VERIFIED GAME RECORD|\\b(TBD|TODO|PLACEHOLDER|MOCK)\\b" }
    },
    "requiredViewState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewID",
        "label",
        "required",
        "present",
        "missing",
        "rejected",
        "recaptureRequested",
        "verified",
        "status",
        "evidenceFileIDs",
        "blocking",
        "notes"
      ],
      "properties": {
        "viewID": { "$ref": "#/$defs/requiredText" },
        "label": { "$ref": "#/$defs/requiredText" },
        "required": { "type": "boolean" },
        "present": { "type": "boolean" },
        "missing": { "type": "boolean" },
        "rejected": { "type": "boolean" },
        "recaptureRequested": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "status": { "enum": ["missing", "present", "rejected", "recaptureRequested", "verified"] },
        "evidenceFileIDs": {
          "type": "array",
          "items": { "$ref": "#/$defs/requiredText" }
        },
        "blocking": { "type": "boolean" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
