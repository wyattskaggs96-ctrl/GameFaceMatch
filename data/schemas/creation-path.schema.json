{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gamefacematch.local/schemas/creation-path.schema.json",
  "title": "Phase0CreationPath",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "schemaVersion",
    "createdAt",
    "updatedAt",
    "gameID",
    "gameMode",
    "displayName",
    "exactPath",
    "platformIDs",
    "observedPatchIDs",
    "menuItemIDs",
    "reproducibleSteps",
    "requirements",
    "restrictions",
    "appearanceRelevance",
    "dependencies",
    "verificationState",
    "verificationRecordIDs",
    "evidenceFileIDs",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": "phase0-domain-v1" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "gameID": { "type": "string", "minLength": 1 },
    "gameMode": { "type": "string", "minLength": 1 },
    "displayName": { "type": "string", "minLength": 1 },
    "exactPath": { "type": "string", "minLength": 1 },
    "platformIDs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "observedPatchIDs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "menuItemIDs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "reproducibleSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stepNumber", "instruction", "expectedResult", "menuItemID", "evidenceFileIDs"],
        "properties": {
          "stepNumber": { "type": "integer", "minimum": 1 },
          "instruction": { "type": "string", "minLength": 1 },
          "expectedResult": { "type": "string", "minLength": 1 },
          "menuItemID": { "type": ["string", "null"] },
          "evidenceFileIDs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "required", "evidenceFileIDs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "evidenceFileIDs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "severity", "evidenceFileIDs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "blocking"] },
          "evidenceFileIDs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "appearanceRelevance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affectsAppearance", "affectedCatalogKinds", "affectedAttributeFamilies", "notes"],
      "properties": {
        "affectsAppearance": { "type": "boolean" },
        "affectedCatalogKinds": { "type": "array", "items": { "enum": ["head", "hairstyle", "facialHair", "additionalAttribute"] } },
        "affectedAttributeFamilies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "dependencyTestID", "requiredCreationPathID", "evidenceFileIDs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "dependencyTestID": { "type": ["string", "null"] },
          "requiredCreationPathID": { "type": ["string", "null"] },
          "evidenceFileIDs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "verificationState": { "enum": ["draft", "firstReviewPending", "firstReviewApproved", "secondReviewPending", "verified", "rejected", "retired"] },
    "verificationRecordIDs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidenceFileIDs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["unknown", "planned", "inAudit", "supported", "unsupported", "retired"] }
  }
}
