{
  "name": "gameface-match-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run catalog:generate && npm run mediapipe:assets && next dev",
    "start": "next start",
    "build": "node scripts/clean-next-build.mjs && npm run catalog:generate && npm run mediapipe:assets && next build && npm run build:guard",
    "build:staging": "node scripts/build-staging.mjs",
    "catalog:generate": "node scripts/generate-production-catalog.mjs",
    "mediapipe:assets": "node scripts/copy-mediapipe-assets.mjs",
    "build:guard": "node scripts/production-bundle-guard.mjs",
    "typecheck": "npm run catalog:generate && tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:phase0": "playwright test --config playwright.phase0.config.ts",
    "test:e2e:staging": "npm run build:staging && playwright test --config playwright.staging.config.ts",
    "test:e2e:ci": "npm run build && npm run test:e2e",
    "integrity": "node scripts/integrity-check.mjs",
    "catalog:validate": "node scripts/validate-catalog.mjs ../data/catalog/production",
    "catalog:validate-record": "node ../scripts/catalog-tools.mjs validate-record",
    "catalog:validate-audit-record": "node ../scripts/catalog-tools.mjs validate-audit-record",
    "catalog:validate-package": "node ../scripts/catalog-tools.mjs validate-package",
    "catalog:validate-import": "node ../scripts/catalog-import-validator.mjs validate-import",
    "catalog:import-check": "node ../scripts/catalog-import-validator.mjs --check",
    "catalog:verify-assets": "node ../scripts/catalog-tools.mjs verify-assets",
    "phase0:detailed-facial-controls": "node ../scripts/cf27-detailed-facial-controls-research-catalog.mjs",
    "phase0:body-controls": "node ../scripts/cf27-body-control-research-catalog.mjs",
    "phase0:standardized-capture-qa": "node ../scripts/cf27-standardized-capture-qa.mjs",
    "catalog:create-audit-session": "node ../scripts/catalog-tools.mjs create-audit-session",
    "catalog:import-csv": "node ../scripts/catalog-tools.mjs import-csv",
    "catalog:export-csv": "node ../scripts/catalog-tools.mjs export-csv",
    "catalog:compare-versions": "node ../scripts/catalog-tools.mjs compare-versions",
    "catalog:patch-reaudit": "node ../scripts/catalog-tools.mjs patch-reaudit",
    "catalog:publish-package": "node ../scripts/catalog-tools.mjs publish-package",
    "catalog:rollback-package": "node ../scripts/catalog-tools.mjs rollback-package",
    "evidence:manifest": "node ../scripts/evidence-manifest.mjs",
    "catalog:placeholders": "node ../scripts/catalog-tools.mjs detect-placeholders ../data/catalog/production",
    "catalog:fixtures": "node ../scripts/catalog-tools.mjs detect-fixtures ../data/catalog/production",
    "check": "npm run typecheck && npm run lint && npm run test && npm run catalog:validate && npm run integrity && npm run build:guard"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
